<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="UAS_Utility.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="LOSFormula" Type="System.String" Scope="User">
      <Value Profile="(Default)">{HeightBuffer} + {HighestPeak}</Value>
    </Setting>
    <Setting Name="AGLFormula" Type="System.String" Scope="User">
      <Value Profile="(Default)">{HeightBuffer} + {HighestPeak} - {HomeAltitude}</Value>
    </Setting>
    <Setting Name="RTLAltitudeFormula" Type="System.String" Scope="User">
      <Value Profile="(Default)">{HighestPeak} - {HomeAltitude} + 150</Value>
    </Setting>
  </Settings>
</SettingsFile>