<UserControl x:Class="UAS_Utility.Views.Formula"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UAS_Utility.Views"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mah:DialogParticipation.Register="{Binding}"
             mc:Ignorable="d" 
             d:DesignHeight="788.646" d:DesignWidth="926.115">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Calculation Formulas"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Customize the formulas used for altitude calculations."
                       Foreground="Gray"
                       Margin="0,0,0,20"/>

            <!-- LOS Formula -->
            <TextBlock Text="LOS Formula"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding LOSFormula, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10"
                     MinHeight="38"
                     Margin="0,0,0,15"/>

            <!-- AGL Formula -->
            <TextBlock Text="AGL Formula"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding AGLFormula, UpdateSourceTrigger=PropertyChanged}"
                     Padding="10"
                     MinHeight="38"
                     Margin="0,0,0,20"/>

            <!-- Available Variables -->
            <Border BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="15"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Available Variables"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Use these variable names inside curly braces {}."
                               Foreground="Gray"
                               FontSize="12"
                               Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="HeightBuffer"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="Additional altitude buffer."
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="1"
                                   Text="HighestPeak"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Text="Highest terrain elevation."
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="2"
                                   Text="HomeAltitude"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Text="Home point altitude."
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="3"
                                   Text="LOSResult"
                                   FontWeight="SemiBold"
                                   Margin="0,5"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="Calculated line-of-sight altitude."
                                   Margin="0,5"/>
                    </Grid>

                    <TextBlock Text="Example LOS formula: {HeightBuffer} + {HighestPeak}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="12"
                               Background="#F3F4F6"
                               Padding="10"
                               Margin="0,15,0,0"/>
                </StackPanel>
            </Border>

            <!-- Save -->
            <Button Content="Save Formulas"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Right"
                    Padding="20,9"
                    MinWidth="130"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
