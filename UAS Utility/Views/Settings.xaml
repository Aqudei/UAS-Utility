<UserControl x:Class="UAS_Utility.Views.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="Settings"/>
            <TextBlock Margin="0,4,0,0" Opacity="0.7" Text="Manage application preferences and utility shortcuts."/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="General" Padding="16,7">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,18,18,18" MaxWidth="760">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Capture settings"/>
                        <TextBlock Margin="0,5,0,14" Opacity="0.7" Text="Screenshots captured with the global shortcut are saved here." TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" Text="Capture folder"/>
                            <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding CaptureFolder}" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Margin="10,0,0,0" Padding="14,6" Command="{Binding OpenCaptureFolderCommand}" Content="Open folder"/>
                        </Grid>
                        <TextBlock Margin="0,20,0,0" FontSize="18" FontWeight="SemiBold" Text="Session"/>
                        <TextBlock Margin="0,5,0,14" Opacity="0.7" Text="Restore the default application locations used during this session." TextWrapping="Wrap"/>
                        <Button HorizontalAlignment="Left" Padding="14,6" Command="{Binding ResetCommand}" Content="Restore defaults"/>
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource MahApps.Brushes.Accent}" Text="{Binding StatusMessage}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Appearance" Padding="16,7">
                <StackPanel Margin="4,18,18,18" MaxWidth="760">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Appearance"/>
                    <TextBlock Margin="0,5,0,18" Opacity="0.7" Text="The current visual theme is provided by MahApps.Metro." TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Active theme"/>
                        <ComboBox Grid.Column="1" IsReadOnly="True" SelectedIndex="0">
                            <ComboBoxItem Content="{Binding Theme}"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Header="Shortcuts" Padding="16,7">
                <StackPanel Margin="4,18,18,18" MaxWidth="760">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Keyboard shortcuts"/>
                    <TextBlock Margin="0,5,0,18" Opacity="0.7" Text="Use these shortcuts to keep common utility actions close at hand." TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Capture screenshot"/>
                        <TextBox Grid.Column="1" IsReadOnly="True" Text="{Binding Hotkey}"/>
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
